# Copy this file to .env.local (already gitignored) and fill in real
# values there. Never commit real secrets.

# Buttondown API key, used by app/api/subscribe/route.ts to add emails
# captured by the EmailGate component to your Buttondown subscriber list.
# Get one from https://buttondown.com -> Settings -> Programming -> API Key
# (after creating a free account). Without this set, the email gate still
# works end to end in the browser, but submitted emails are only logged to
# the server console instead of actually being saved anywhere.
BUTTONDOWN_API_KEY=

# The site's real production domain, used by app/sitemap.ts and
# app/robots.ts. Falls back to https://example.com if unset.
SITE_URL=

# Google Analytics 4 Measurement ID, used in app/layout.tsx to load the
# gtag.js tracking script. Get one by creating a GA4 property for
# breakgroundu.com at https://analytics.google.com -> Admin -> Create Property,
# then Data Streams -> Web -> add breakgroundu.com, which gives you an ID
# shaped like G-XXXXXXXXXX. Must be NEXT_PUBLIC_-prefixed since it's read
# in the browser. Leave blank to skip loading GA (Vercel Analytics, wired
# separately below, keeps running either way).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Adzuna job-search API credentials, used by app/api/jobs/route.ts to
# power the Action Plan page's live "openings near you" results. Get a
# key from https://developer.adzuna.com/signup. Note: this turned out
# to be a limited one-time trial quota on this account, not an ongoing
# free tier -- see JOBS_MOCK_MODE and ADZUNA_MAX_CALLS_PER_PROCESS below
# for how this project protects that budget while testing. Without
# these set, the live-jobs section quietly stays off and the page falls
# back to its existing static job-board search-link buttons -- nothing
# breaks.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set to 1 to see the live-jobs section fully rendered (every badge,
# every posted-date state) using clearly-fake example listings, with no
# real Adzuna call at all -- works even with no key set above. LOCAL
# ONLY: never set this in Vercel, it would show fake listings to real
# visitors.
JOBS_MOCK_MODE=

# A hard ceiling on real Adzuna calls per warm server process (default
# 5 if unset), on top of response caching and the per-IP rate limiter
# already in app/api/jobs/route.ts -- a deliberate backstop so a
# limited trial quota can't get burned through by, say, a dev-server
# session that runs longer than expected. Resets when the server
# restarts; raise this only when you deliberately want to spend more
# real calls in one sitting.
ADZUNA_MAX_CALLS_PER_PROCESS=
