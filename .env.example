# Copy this file to .env.local (already gitignored) and fill in real
# values there. Never commit real secrets.

# Buttondown API key, used by app/api/subscribe/route.ts to add emails
# captured by the EmailGate component to your Buttondown subscriber list.
# Get one from https://buttondown.com -> Settings -> Programming -> API Key
# (after creating a free account). Without this set, the email gate still
# works end to end in the browser, but submitted emails are only logged to
# the server console instead of actually being saved anywhere.
BUTTONDOWN_API_KEY=

# The site's real production domain, used by app/sitemap.ts and
# app/robots.ts. Falls back to https://example.com if unset.
SITE_URL=

# Google Analytics 4 Measurement ID, used in app/layout.tsx to load the
# gtag.js tracking script. Get one by creating a GA4 property for
# hardhatu.com at https://analytics.google.com -> Admin -> Create Property,
# then Data Streams -> Web -> add hardhatu.com, which gives you an ID
# shaped like G-XXXXXXXXXX. Must be NEXT_PUBLIC_-prefixed since it's read
# in the browser. Leave blank to skip loading GA (Vercel Analytics, wired
# separately below, keeps running either way).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
